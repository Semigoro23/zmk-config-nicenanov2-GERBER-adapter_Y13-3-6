#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>


/* 速度倍率（例）:
 * いま 2/1 (=2倍) になっているなら、
 * 1.1倍にしたい場合は 11/10 にできます（小数は使わず分数で調整）
 * 例: <&zip_xy_scaler 11 10>
 */
&mmv_input_listener { input-processors = <&zip_xy_scaler 50 10>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 35 10>; };

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        /* =========================
         * layer0 (Base)
         * ========================= */
        layer_0 {
            bindings = <
                &kp TAB         &kp Q    &kp W    &kp E    &kp R    &kp T       &kp Y    &kp U    &kp I    &kp O    &kp P      &kp BACKSPACE
                &kp LSHIFT      &kp A    &kp S    &kp D    &kp F    &kp G       &kp H    &kp J    &kp K    &kp L    &kp SEMI   &kp COLON
                &kp LCTRL       &kp Z    &kp X    &kp C    &kp V    &kp B       &kp N    &kp M    &kp COMMA &kp DOT  &kp FSLH   &kp MINUS

                                              &kp LALT   &kp SPACE  &mo 1      &mo 2     &kp ENTER
                                                        &mkp MB1   &mkp MB2   &mo 3
                /* 5-way: UP, DOWN, LEFT, RIGHT, CENTER */
                &kp UP &kp DOWN &kp LEFT &kp RIGHT &mkp MB1

            >;

        };

        /* =========================
         * layer1
         * （表のとおり：home / win+r / win+d / ctrl+c / ctrl+v / BS など）
         * ※ PrintScreen は PSCRN
         * ========================= */
        layer_1 {
            bindings = <
                &kp ESC         &none      &kp LC(W)  &kp LG(E)   &kp LG(R)  &kp LC(T)          &kp LC(Y)  &kp END      &kp END    &kp RPAR   &kp MINUS   &kp INT_YEN
                &kp CAPS        &none      &kp PSCRN  &kp LG(D)   &kp LC(C)  &kp LC(X)          &kp DEL    &kp LC(V)    &kp DEL    &kp LG(L)  &none      &kp LS(BSLH)
                &kp LCTRL       &kp LC(Z)  &none      &kp LC(Z)   &kp LC(A)  &kp BACKSPACE      &kp LC(N)  &kp LC(V)    &kp COMMA  &kp DOT    &kp FSLH   &kp UNDERSCORE

                                              &kp LALT   &kp SPACE  &trans                      &mo 2     &kp ENTER
                                                         &mkp MB1   &mkp MB2                    &mo 3
                /* 5-way: UP, DOWN, LEFT, RIGHT, CENTER */
                &kp UP &kp DOWN &kp LEFT &kp RIGHT &mkp MB1

            >;

        };

        /* =========================
         * layer2 (US記号 + Fキー / nav)
         * ========================= */
        layer_2 {
            bindings = <
                &kp TILDE         &kp EXCL  &kp STAR      &kp HASH      &kp DLLR   &kp PRCNT          &kp SQT     &kp DQT     &kp PLUS      &kp MINUS   &kp QMARK     &kp PIPE
                &kp LSHIFT      &none     &kp LT        &kp LBKT      &kp LBRC   &kp LPAR           &kp RPAR    &kp RBRC    &kp RBKT      &kp GT      &kp EQUAL     &kp BACKSLASH
                &kp LCTRL       &kp LGUI  &kp CARET     &kp AMPS      &kp SEMI   &kp COLON          &kp FSLH    &kp AT      &kp COMMA     &kp DOT     &kp GRAVE     &kp UNDERSCORE

                                                      &kp LALT   &kp SPACE  &mo 1                     &trans    &kp ENTER
                                                                 &mkp MB1   &mkp MB2                  &mo 3
                /* 5-way: UP, DOWN, LEFT, RIGHT, CENTER */
                &kp UP &kp DOWN &kp LEFT &kp RIGHT &mkp MB1

            >;

        };

        /* =========================
         * layer3 (M1..M10 + arrows + volume)
         * ========================= */
        layer_3 {
            bindings = <
                &kp N0          &kp N1        &kp N2    &kp N3    &kp N4     &kp N5            &kp F1        &kp F2    &kp UP    &kp F3        &kp F4           &kp BACKSPACE
                &kp LSHIFT      &kp N6        &kp N7    &kp N8    &kp N9     &kp LC(LS(TAB))   &kp LC(TAB)   &kp LEFT  &kp DOWN  &kp RIGHT     &kp F5           &kp C_VOL_UP
                &sys_reset      &kp F9        &kp F10   &kp F11   &kp F12    &kp HOME          &kp END       &kp F6    &kp F7    &kp F8        &sys_reset       &kp C_VOL_DN

                                                         &kp LALT   &kp SPACE  &mo 1        &mo 2     &kp ENTER
                                                                 &mkp MB1   &mkp MB2        &trans
                /* 5-way: UP, DOWN, LEFT, RIGHT, CENTER */
                &kp UP &kp DOWN &kp LEFT &kp RIGHT &mkp MB1

            >;

        };
    };
};
